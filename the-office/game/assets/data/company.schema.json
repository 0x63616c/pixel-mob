{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel-office.local/company.schema.json",
  "title": "Plenum Industries world data (Bevy / serde, snake_case)",
  "description": "Exported from src/data/company.js by tools/export-data.mjs. Times are HH:MM strings. Keys are snake_case. See DATA.md.",
  "type": "object",
  "required": [
    "meta",
    "company",
    "orgs",
    "teams",
    "people",
    "visitors",
    "pets",
    "layout",
    "rooms",
    "events",
    "lines"
  ],
  "additionalProperties": true,
  "$defs": {
    "time": {
      "type": "string",
      "description": "24h clock 'HH:MM'. '24:00' is allowed as an end time only. Items never cross midnight.",
      "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
    },
    "day": {
      "type": "string",
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ]
    },
    "facing": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ]
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": true,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "facing": {
          "$ref": "#/$defs/facing"
        }
      }
    },
    "rect": {
      "type": "object",
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": true,
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "energy": {
          "type": "number"
        },
        "hunger": {
          "type": "number"
        },
        "social": {
          "type": "number"
        },
        "stress": {
          "type": "number"
        },
        "focus": {
          "type": "number"
        }
      }
    },
    "look": {
      "type": "object",
      "required": [
        "skin",
        "hair",
        "hair_style",
        "shirt",
        "pants",
        "accessory"
      ],
      "additionalProperties": true,
      "properties": {
        "skin": {
          "description": "hex string or 0..6 index",
          "type": [
            "string",
            "integer"
          ]
        },
        "hair": {
          "type": "string"
        },
        "hair_style": {
          "type": "string"
        },
        "shirt": {
          "type": "string"
        },
        "pants": {
          "type": "string"
        },
        "shoes": {
          "type": "string"
        },
        "accessory": {
          "type": "string"
        },
        "extra": {
          "description": "beard, mustache, freckles, blush \u2014 string or array"
        },
        "outfit": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "spots": {
          "type": "string"
        },
        "collar": {
          "type": "string"
        },
        "coat": {
          "type": "string"
        }
      }
    },
    "cal_item": {
      "type": "object",
      "required": [
        "start",
        "end",
        "title",
        "type",
        "room_id",
        "attendees"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "description": "Shared meeting id; the same id appears on every attendee's calendar."
        },
        "start": {
          "$ref": "#/$defs/time"
        },
        "end": {
          "$ref": "#/$defs/time"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "standup, sync, 1on1, focus, lunch, dinner, snack, nap, allhands, interview, wellness, social, deploy, review, patrol, tidy, reception, onboarding, ..."
        },
        "room_id": {
          "type": "string",
          "description": "rooms[].id, a layout.poi key, 'desk', or 'floor'."
        },
        "attendees": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "organizer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/day"
          },
          "description": "Omitted = every day. Already applied in calendar_by_day."
        },
        "event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mismatch": {
          "type": "boolean",
          "description": "Deliberate capacity mismatch."
        },
        "visitors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "join": {
          "type": "number"
        },
        "ignore": {
          "type": "number"
        },
        "gossip": {
          "type": "number"
        },
        "flee": {
          "type": "number"
        }
      }
    },
    "director": {
      "type": "object",
      "description": "World director metadata for scheduling an event.",
      "additionalProperties": true,
      "properties": {
        "window": {
          "type": "object",
          "properties": {
            "start": {
              "$ref": "#/$defs/time"
            },
            "end": {
              "$ref": "#/$defs/time"
            }
          }
        },
        "days": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/day"
              }
            }
          ]
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cooldown": {
          "type": "number"
        },
        "weight": {
          "type": "number"
        },
        "tension_delta": {
          "type": "number"
        },
        "participants": {
          "type": "object"
        },
        "period": {
          "type": "string",
          "enum": [
            "anytime",
            "morning",
            "day",
            "afternoon",
            "meal",
            "night"
          ]
        }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "tile_size",
        "start_time",
        "start_day",
        "days"
      ],
      "additionalProperties": true,
      "properties": {
        "tile_size": {
          "type": "integer"
        },
        "start_time": {
          "$ref": "#/$defs/time"
        },
        "start_day": {
          "$ref": "#/$defs/day"
        },
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/day"
          },
          "minItems": 7,
          "maxItems": 7
        },
        "version": {
          "type": [
            "integer",
            "string"
          ]
        },
        "source": {
          "type": "string"
        },
        "key_style": {
          "type": "string"
        },
        "time_format": {
          "type": "string"
        },
        "build_warnings": {
          "type": "array"
        },
        "panel": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "emoji": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "company": {
      "type": "object",
      "required": [
        "name",
        "tagline",
        "product",
        "version"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "mission": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "product_description": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "founded": {
          "type": [
            "integer",
            "string"
          ]
        },
        "hq": {
          "type": "string"
        },
        "founder": {
          "type": "object",
          "required": [
            "name",
            "title"
          ],
          "additionalProperties": true,
          "properties": {
            "name": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "portrait_quote": {
              "type": "string"
            }
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quotas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "team_id",
              "label"
            ],
            "additionalProperties": true,
            "properties": {
              "team_id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "target": {
                "type": "number"
              },
              "start": {
                "type": "number"
              }
            }
          }
        },
        "rivalries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "a",
              "b",
              "name"
            ],
            "properties": {
              "a": {
                "type": "string"
              },
              "b": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "prizes": {
          "type": "array"
        }
      }
    },
    "orgs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lead_id": {
            "type": "string"
          }
        }
      }
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "org",
          "color",
          "section_id",
          "lead_id"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "short_name": {
            "type": "string"
          },
          "org": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "section_id": {
            "type": "string"
          },
          "lead_id": {
            "type": "string"
          },
          "standup": {
            "type": "object",
            "properties": {
              "time": {
                "$ref": "#/$defs/time"
              },
              "room_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          },
          "quota": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "start": {
                "type": "number"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "team_id",
          "kind",
          "arrive",
          "traits",
          "look",
          "quirk",
          "calendar"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "first": {
            "type": "string"
          },
          "pronouns": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "team_id": {
            "type": "string"
          },
          "org": {
            "type": "string"
          },
          "manager_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "desk_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string",
            "description": "staff | receptionist | cleaner (Facilities crew) | security (Floor Supervisor)"
          },
          "arrive": {
            "$ref": "#/$defs/time"
          },
          "leave": {
            "type": [
              "string",
              "null"
            ],
            "description": "Always null: 24/7, nobody leaves."
          },
          "traits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "needs": {
            "$ref": "#/$defs/needs"
          },
          "look": {
            "$ref": "#/$defs/look"
          },
          "belongings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quirk": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "seed": {
            "type": "integer"
          },
          "calendar": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cal_item"
            }
          },
          "calendar_by_day": {
            "type": "object",
            "description": "Pre-expanded, sorted calendar for each weekday. Prefer this in Rust over filtering calendar yourself.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/cal_item"
              }
            }
          }
        }
      }
    },
    "visitors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "day",
          "arrive",
          "leave",
          "host_id"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "day": {
            "$ref": "#/$defs/day"
          },
          "arrive": {
            "$ref": "#/$defs/time"
          },
          "leave": {
            "$ref": "#/$defs/time"
          },
          "host_id": {
            "type": "string"
          },
          "look": {
            "$ref": "#/$defs/look"
          },
          "calendar": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cal_item"
            }
          },
          "calendar_by_day": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/cal_item"
              }
            }
          }
        }
      }
    },
    "pets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "species"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "species": {
            "type": "string",
            "enum": [
              "dog",
              "goat"
            ]
          },
          "look": {
            "type": "object"
          },
          "bed": {
            "anyOf": [
              {
                "$ref": "#/$defs/point"
              },
              {
                "type": "null"
              }
            ]
          },
          "traits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quirk": {
            "type": "string"
          },
          "appears_from_nowhere": {
            "type": "boolean"
          },
          "owner_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "w",
        "h",
        "tiles",
        "blocked",
        "sections",
        "desks",
        "furniture",
        "poi",
        "elevator"
      ],
      "additionalProperties": true,
      "properties": {
        "w": {
          "type": "integer"
        },
        "h": {
          "type": "integer"
        },
        "tile_size": {
          "type": "integer"
        },
        "legend": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Visual floor tint only; h rows of w chars. No walls."
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "'#' blocked, '.' walkable. Authoritative for A*."
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "rect"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "sign": {
                "type": "string"
              },
              "team_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rect": {
                "$ref": "#/$defs/rect"
              },
              "label": {
                "$ref": "#/$defs/point"
              },
              "light_zone": {
                "type": [
                  "string",
                  "boolean",
                  "number"
                ]
              }
            }
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "x",
              "y",
              "w",
              "h"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "section_id": {
                "type": "string"
              },
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "w": {
                "type": "integer"
              },
              "h": {
                "type": "integer"
              }
            }
          }
        },
        "desks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "x",
              "y",
              "facing"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "facing": {
                "$ref": "#/$defs/facing"
              },
              "section_id": {
                "type": "string"
              },
              "table_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "monitor": {
                "$ref": "#/$defs/point"
              },
              "owner_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "type": "string"
              }
            }
          }
        },
        "furniture": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "x",
              "y",
              "w",
              "h",
              "solid"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "w": {
                "type": "integer"
              },
              "h": {
                "type": "integer"
              },
              "solid": {
                "type": "boolean"
              },
              "facing": {
                "$ref": "#/$defs/facing"
              },
              "room_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "section_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "desk_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "label": {
                "type": "string"
              },
              "decal": {
                "type": "boolean"
              }
            }
          }
        },
        "poi": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/point"
          }
        },
        "queues": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/point"
            }
          }
        },
        "elevator": {
          "type": "object",
          "required": [
            "rect",
            "door_tiles",
            "spawn"
          ],
          "additionalProperties": true,
          "properties": {
            "rect": {
              "$ref": "#/$defs/rect"
            },
            "door_tiles": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/point"
              }
            },
            "spawn": {
              "$ref": "#/$defs/point"
            },
            "exit_spawn": {
              "$ref": "#/$defs/point"
            }
          }
        },
        "signs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "x",
              "y",
              "text"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "text": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              }
            }
          }
        },
        "void_props": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "x",
              "y"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "x": {
